{
	"name": "sportsdey-admin",
	"private": true,
	"type": "module",
	"scripts": {
		"clean": "node -e \"const fs=require('node:fs');for (const d of ['dist','.tanstack']) fs.rmSync(d,{recursive:true,force:true});\"",
		"build": "vite build",
		"build:staging": "pnpm run clean && vite build --mode staging",
		"build:production": "pnpm run clean && vite build --mode production",
		"serve": "vite preview",
		"dev": "vite dev --port=3002",
		"dev:staging": "vite dev --mode staging --port=3002",
		"deploy:staging": "pnpm run build:staging && wrangler deploy dist/server/index.js --assets dist/client --env staging --config wrangler.jsonc",
		"deploy:production": "pnpm run build:production && wrangler deploy dist/server/index.js --assets dist/client --env production --config wrangler.jsonc",
		"cf-typegen": "wrangler types --env-interface Env"
	},
	"dependencies": {
		"@radix-ui/react-slot": "^1.2.4",
		"@tailwindcss/vite": "^4.1.8",
		"@tanstack/react-query": "^5.85.5",
		"@tanstack/react-router": "^1.132.31",
		"@tanstack/react-start": "^1.132.31",
		"@tanstack/router-plugin": "^1.132.31",
		"@tiptap/core": "^3.22.4",
		"@tiptap/extension-color": "^3.22.4",
		"@tiptap/extension-font-family": "^3.22.4",
		"@tiptap/extension-highlight": "^3.22.4",
		"@tiptap/extension-placeholder": "^3.22.4",
		"@tiptap/extension-text-align": "^3.22.4",
		"@tiptap/extension-text-style": "^3.22.4",
		"@tiptap/extension-underline": "^3.22.4",
		"@tiptap/pm": "^3.22.4",
		"@tiptap/react": "^3.22.4",
		"@tiptap/starter-kit": "^3.22.4",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"docx": "^9.7.1",
		"framer-motion": "^12.38.0",
		"jspdf": "^4.2.1",
		"jspdf-autotable": "^5.0.8",
		"lucide-react": "^0.525.0",
		"react": "19.1.0",
		"react-dom": "19.1.0",
		"react-icons": "^5.6.0",
		"sonner": "^2.0.3",
		"tailwind-merge": "^3.3.1",
		"tailwindcss": "^4.1.3",
		"vite-tsconfig-paths": "^5.1.4",
		"xlsx": "^0.18.5"
	},
	"devDependencies": {
		"@biomejs/biome": "2.4.5",
		"@cloudflare/vite-plugin": "^1.13.8",
		"@tailwindcss/typography": "^0.5.16",
		"@types/react": "^19.2.17",
		"@types/react-dom": "^19.2.3",
		"@vitejs/plugin-react": "^5.0.4",
		"typescript": "^5.7.2",
		"vite": "^7.0.2",
		"vite-plugin-svgr": "^4.5.0",
		"wrangler": "^4.57.0"
	}
}
